{
    "name": "relayer",
    "version": "0.0.0",
    "description": "Relayer API",
    "author": "Peersyst",
    "private": true,
    "scripts": {
        "start": "nest start --watch",
        "build": "nest build",
        "clean": "rimraf .turbo coverage dist node_modules",
        "test": "jest  --maxWorkers=30% --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json --coverage",
        "lint": "eslint . --fix",
        "check-types": "npx tsc --noEmit",
        "ts-script": "env-cmd --silent ts-node --skipProject --compilerOptions '{\"module\":\"NodeNext\",\"target\":\"ES2022\",\"moduleResolution\":\"NodeNext\",\"esModuleInterop\":true,\"skipLibCheck\":true,\"allowJs\":true,\"resolveJsonModule\":true,\"isolatedModules\":true,\"strict\":true,\"forceConsistentCasingInFileNames\":true,\"strictPropertyInitialization\":false,\"declaration\":false,\"removeComments\":true,\"sourceMap\":true,\"emitDecoratorMetadata\":true,\"experimentalDecorators\":true}'",
        "db:seed": "nr ts-script src/seed/cmd/seed.ts",
        "db:pack": "nr ts-script src/seed/cmd/pack.ts"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.266.1",
        "@backend/config": "workspace:*",
        "@backend/core": "workspace:*",
        "@bloxer/ethers-typechain-contract": "0.0.5",
        "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.6.5",
        "@nestjs/cli": "^10.3.0",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.2",
        "@nestjs/platform-express": "^10.2.10",
        "@nestjs/swagger": "~7.1.16",
        "bcrypt": "^5.1.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "cross-env": "^7.0.3",
        "ethers": "^5.7.2",
        "express": "^4.19.2",
        "express-openapi-validator": "^5.0.1",
        "helmet": "^6.0.1",
        "morgan": "^1.10.0",
        "nest-winston": "^1.8.0",
        "nestjs-command": "^3.1.3",
        "passport": "0.6.0",
        "passport-jwt": "4.0.1",
        "passport-local": "1.0.0",
        "pg": "^8.9.0",
        "reflect-metadata": "0.1.13",
        "rxjs": "^7.8.0",
        "swagger-ui-express": "4.6.0",
        "typeorm": "^0.3.12",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.2.10",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "4.17.17",
        "@types/jest": "^29.4.0",
        "@types/morgan": "^1.9.4",
        "@types/node": "^22.5.5",
        "@types/supertest": "2.0.12",
        "@types/ws": "8.5.4",
        "env-cmd": "^10.1.0",
        "jest": "29.4.2",
        "supertest": "6.3.3",
        "ts-jest": "29.0.5",
        "ts-loader": "9.4.2",
        "ts-node": "10.9.2",
        "typescript": "latest"
    }
}
