{
    "name": "@frontend/axelar",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "dist": "pnpm run build && node ../../../scripts/prebuild-exports.cjs"
    },
    "exports": {
        ".": "./src/index.ts",
        "./interfaces": "./src/interfaces/i-axelar.service.ts",
        "./errors": "./src/errors/axelar.errors.ts"
    },
    "peerDependencies": {
        "@frontend/bridge": "workspace:*",
        "@frontend/chain": "workspace:*",
        "@frontend/config": "workspace:*",
        "@frontend/core": "workspace:*",
        "@frontend/token": "workspace:*",
        "@shared/modules": "workspace:*",
        "@shared/utils": "workspace:*"
    },
    "devDependencies": {
        "@frontend/bridge": "workspace:*",
        "@frontend/chain": "workspace:*",
        "@frontend/config": "workspace:*",
        "@frontend/core": "workspace:*",
        "@frontend/token": "workspace:*",
        "@shared/eslint": "workspace:*",
        "@shared/modules": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@shared/utils": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "latest",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "latest"
    }
}
