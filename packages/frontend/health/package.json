{
    "name": "@frontend/health",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "prebuild": "VERSION=$(git describe --abbrev=0 --tags --match=\"web*\" | sed \"s/web@v//\")",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/common/index.d.ts",
            "require": "./dist/common/index.js",
            "import": "./dist/common/index.mjs"
        },
        "./domain/controllers": {
            "types": "./dist/domain/controllers/index.d.ts",
            "require": "./dist/domain/controllers/index.js",
            "import": "./dist/domain/controllers/index.mjs"
        },
        "./domain/interfaces": {
            "types": "./dist/domain/interfaces/index.d.ts",
            "require": "./dist/domain/interfaces/index.js",
            "import": "./dist/domain/interfaces/index.mjs"
        },
        "./ui/interfaces": {
            "types": "./dist/ui/interfaces/index.d.ts",
            "require": "./dist/ui/interfaces/index.js",
            "import": "./dist/ui/interfaces/index.mjs"
        },
        "./ui/queries": {
            "types": "./dist/ui/queries/index.d.ts",
            "require": "./dist/ui/queries/index.js",
            "import": "./dist/ui/queries/index.mjs"
        }
    },
    "peerDependencies": {
        "@frontend/core": "workspace:*",
        "@frontend/query": "workspace:*",
        "@shared/api": "workspace:*",
        "@shared/modules": "workspace:*",
        "@tanstack/react-query": "^5.52.2"
    },
    "devDependencies": {
        "@frontend/core": "workspace:*",
        "@frontend/query": "workspace:*",
        "@shared/eslint": "workspace:*",
        "@shared/api": "workspace:*",
        "@shared/modules": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@tanstack/react-query": "^5.52.2",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.5.5",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "latest"
    }
}
