{
    "name": "@frontend/settings",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "dist": "pnpm run build && node ../../../scripts/prebuild-exports.cjs"
    },
    "exports": {
        ".": "./src/common/index.ts",
        "./data-access/services/browser": "./src/data-access/services/browser/index.ts",
        "./data-access/repositories": "./src/data-access/repositories/index.ts",
        "./domain/controllers": "./src/domain/controllers/index.ts",
        "./domain/decorators": "./src/domain/decorators/index.ts",
        "./domain/errors": "./src/domain/settings.errors.ts",
        "./domain/events": "./src/domain/settings.events.ts",
        "./domain/state": "./src/domain/settings.state.ts",
        "./domain/interfaces": "./src/domain/interfaces/index.ts",
        "./ui/state": "./src/ui/state/index.ts",
        "./ui/interfaces": "./src/ui/interfaces/index.ts",
        "./ui/query": "./src/ui/query/index.ts",
        "./mocks/common": "./test/mocks/common/index.ts",
        "./mocks/data-access/service": "./test/mocks/data-access/service/index.ts",
        "./mocks/data-access/repositories": "./test/mocks/data-access/repositories/index.ts",
        "./mocks/domain/controllers": "./test/mocks/domain/controllers/index.ts",
        "./mocks/domain/state": "./test/mocks/domain/state/settings.state.mock.ts",
        "./mocks/ui/state": "./test/mocks/ui/state/index.ts"
    },
    "peerDependencies": {
        "@frontend/core": "workspace:*",
        "@frontend/events": "workspace:*",
        "@frontend/query": "workspace:*",
        "@tanstack/react-query": "^5.52.2",
        "expo-localization": "~14.8.4",
        "zustand": "^5.0.0-rc.0"
    },
    "devDependencies": {
        "@frontend/core": "workspace:*",
        "@frontend/events": "workspace:*",
        "@frontend/query": "workspace:*",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@tanstack/react-query": "^5.52.2",
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "expo-localization": "~14.8.4",
        "typescript": "latest",
        "zustand": "^5.0.0-rc.0"
    }
}
