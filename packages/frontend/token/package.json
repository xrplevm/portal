{
    "name": "@frontend/token",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "test --coverage --passWithNoTests",
        "test:watch": "test --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "dist": "pnpm run build && node ../../../scripts/prebuild-exports.cjs"
    },
    "exports": {
        ".": "./src/common/index.ts",
        "./mocks/common": "./test/mocks/common/index.ts"
    },
    "peerDependencies": {},
    "devDependencies": {
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "expo-localization": "~14.8.4",
        "typescript": "latest"
    }
}
