{
    "name": "@shared/api",
    "author": "Peersyst",
    "version": "0.0.0",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "generate": "openapi -i ../../../apps/api/openapi-spec.json -o src --exportSchemas=true --exportModels=true --useUnionTypes --postfixServices=Api",
        "dist": "pnpm run build && node ../../../scripts/prebuild-exports.cjs"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "devDependencies": {
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@types/node": "latest",
        "openapi-typescript": "^7.3.0",
        "openapi-typescript-codegen": "^0.29.0",
        "typescript": "latest"
    }
}
